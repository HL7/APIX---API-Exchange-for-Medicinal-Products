CodeSystem: APIXTaskOutputTypeCS
Id: apix-task-output-type
Title: "Example APIX Task Output Types Code System"
Description: "Example Code system for task output types in APIX regulatory submissions"
//* ^url = "http://example.org/CodeSystem/apix-task-output-type"
* ^status = #draft
* ^caseSensitive = true
* ^experimental = true

* #cover-letter "Cover Letter" "Cover letter for the submission"
* #questionnaire-response "Questionnaire Response" "Response to information requests or questions"
* #stability-data "Stability Data" "Stability study data and reports"

* #regulatory-document "Regulatory Document" "A regulatory document produced as output"
* #assessment-report "Assessment Report" "Regulatory assessment or evaluation report"
* #approval-letter "Approval Letter" "Regulatory approval decision"
* #information-request "Information Request" "List of questions or additional information requests"
* #validation-report "Validation Report" "Technical validation report"
