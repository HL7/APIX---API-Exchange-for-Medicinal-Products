{
  "resourceType": "StructureDefinition",
  "id": "apix-task",
  "url": "http://hl7.org/fhir/uv/apix/StructureDefinition/apix-task",
  "version": "0.1.0",
  "name": "APIXTask",
  "title": "APIX Regulatory Task",
  "status": "draft",
  "date": "2025-11-24",
  "publisher": "Gravitate Health Project",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Task",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Task",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Task.meta",
        "path": "Task.meta",
        "min": 1
      },
      {
        "id": "Task.meta.versionId",
        "path": "Task.meta.versionId",
        "min": 1
      },
      {
        "id": "Task.meta.lastUpdated",
        "path": "Task.meta.lastUpdated",
        "min": 1
      },
      {
        "id": "Task.meta.profile",
        "path": "Task.meta.profile",
        "min": 1,
        "fixedCanonical": "http://hl7.org/fhir/uv/apix/StructureDefinition/apix-task"
      },
      {
        "id": "Task.text",
        "path": "Task.text",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Task.identifier",
        "path": "Task.identifier",
        "min": 2,
        "slicing": {
          "discriminator": {
            "type": "value",
            "path": "system"
          },
          "rules": "closed"
        }
      },
      {
        "id": "Task.identifier:companyProcedure",
        "path": "Task.identifier",
        "sliceName": "companyProcedure",
        "min": 1,
        "max": "1",
        "short": "Company Procedure Number (MAH internal tracking ID)",
        "mustSupport": true
      },
      {
        "id": "Task.identifier:companyProcedure.system",
        "path": "Task.identifier.system",
        "fixedUri": "http://example.org/company-procedure-id"
      },
      {
        "id": "Task.identifier:regulatorProcedure",
        "path": "Task.identifier",
        "sliceName": "regulatorProcedure",
        "min": 1,
        "max": "1",
        "short": "Regulator Procedure Number",
        "mustSupport": true
      },
      {
        "id": "Task.identifier:regulatorProcedure.system",
        "path": "Task.identifier.system",
        "patternUri": "https://ema.europa.eu/procedure|https://fda.gov/ind|https://pmda.go.jp/application-number"
      },
      {
        "id": "Task.groupIdentifier",
        "path": "Task.groupIdentifier",
        "min": 1,
        "mustSupport": true,
        "short": "Parent/Set ID – groups all Tasks in the same regulatory procedure"
      },
      {
        "id": "Task.status",
        "path": "Task.status",
        "min": 1
      },
      {
        "id": "Task.intent",
        "path": "Task.intent",
        "min": 1,
        "binding": {
          "strength": "required",
          "valueSet": "http://hl7.org/fhir/ValueSet/request-intent"
        }
      },
      {
        "id": "Task.priority",
        "path": "Task.priority",
        "mustSupport": true
      },
      {
        "id": "Task.code",
        "path": "Task.code",
        "min": 1,
        "binding": {
          "strength": "extensible",
          "valueSet": "http://hl7.org/fhir/uv/apix/ValueSet/apix-submission-type-vs"
        }
      },
      {
        "id": "Task.description",
        "path": "Task.description",
        "max": "0"
      },
      {
        "id": "Task.requestedPeriod",
        "path": "Task.requestedPeriod",
        "mustSupport": true
      },
      {
        "id": "Task.authoredOn",
        "path": "Task.authoredOn",
        "min": 1
      },
      {
        "id": "Task.lastModified",
        "path": "Task.lastModified",
        "min": 1
      },
      {
        "id": "Task.requester",
        "path": "Task.requester",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Organization"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Task.requester.reference",
        "path": "Task.requester.reference",
        "patternString": "#requester-org"
      },
      {
        "id": "Task.requestedPerformer",
        "path": "Task.requestedPerformer",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Organization"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Task.requestedPerformer.reference",
        "path": "Task.requestedPerformer.reference",
        "patternString": "#authority-org"
      },
      {
        "id": "Task.owner",
        "path": "Task.owner",
        "max": "0"
      },
      {
        "id": "Task.input",
        "path": "Task.input",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Task.input.type.coding.system",
        "path": "Task.input.type.coding.system",
        "min": 1
      },
      {
        "id": "Task.input.type.coding.code",
        "path": "Task.input.type.coding.code",
        "min": 1
      },
      {
        "id": "Task.input.type.coding.display",
        "path": "Task.input.type.coding.display",
        "min": 1
      },
      {
        "id": "Task.input.value[x]",
        "path": "Task.input.value[x]",
        "min": 1,
        "type": [
          {
            "code": "Reference"
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Task.output",
        "path": "Task.output",
        "mustSupport": true
      },
      {
        "id": "Task.output.type.coding.system",
        "path": "Task.output.type.coding.system",
        "min": 1
      },
      {
        "id": "Task.output.type.coding.code",
        "path": "Task.output.type.coding.code",
        "min": 1
      },
      {
        "id": "Task.output.type.coding.display",
        "path": "Task.output.type.coding.display",
        "min": 1
      },
      {
        "id": "Task.output.value[x]",
        "path": "Task.output.value[x]",
        "min": 1,
        "type": [
          {
            "code": "Reference"
          }
        ],
        "mustSupport": true
      }
    ]
  }
}