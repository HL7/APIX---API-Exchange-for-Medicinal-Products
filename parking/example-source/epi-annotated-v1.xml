    <fullUrl value="urn:uuid:699e4d52-8143-52ea-89af-714c9ef2421f"/>
    <resource>
      <Composition>
        <status value="preliminary"/>
        <type><coding><system value="http://example.org/epi-section"/><code value="product-information"/><display value="Product information (SmPC and package leaflet)"/></coding></type>
        <date value="2027-01-11T10:00:00+01:00"/>
        <author><reference value="urn:uuid:233d1ca4-886c-5bc2-9f08-c074138c4a23"/><display value="SynthPharma AG"/></author>
        <title value="WonderDrug 50 mg film-coated tablets — product information, version 1 (annotated)"/>
        <section>
          <title value="Summary of Product Characteristics"/>
          <code><coding><system value="http://example.org/epi-section"/><code value="smpc"/><display value="Summary of Product Characteristics"/></coding></code>
          <section>
            <title value="4.2 Posology and method of administration"/>
            <code><coding><system value="http://example.org/epi-section"/><code value="smpc-4.2"/><display value="4.2 Posology and method of administration"/></coding></code>
            <text><status value="additional"/><div xmlns="http://www.w3.org/1999/xhtml"><p>The recommended dose is one 50 mg tablet once daily. The tablet can be taken with or without food.</p></div></text>
          </section>
          <section>
            <title value="4.8 Undesirable effects"/>
            <code><coding><system value="http://example.org/epi-section"/><code value="smpc-4.8"/><display value="4.8 Undesirable effects"/></coding></code>
            <text><status value="additional"/><div xmlns="http://www.w3.org/1999/xhtml"><p>Gastrointestinal disorders. Common: abdominal pain. Uncommon: dyspepsia<ins class="rwi-mah" title="Applicant: add nausea following the signal evaluation">, nausea</ins>.</p></div></text>
          </section>
        </section>
        <section>
          <title value="Package Leaflet"/>
          <code><coding><system value="http://example.org/epi-section"/><code value="pil"/><display value="Package Leaflet"/></coding></code>
          <section>
            <title value="3. How to take WonderDrug"/>
            <code><coding><system value="http://example.org/epi-section"/><code value="pil-3"/><display value="3. How to take WonderDrug"/></coding></code>
            <text><status value="additional"/><div xmlns="http://www.w3.org/1999/xhtml"><p>Take one tablet once a day. You can take it with or without food.</p></div></text>
          </section>
          <section>
            <title value="4. Possible side effects"/>
            <code><coding><system value="http://example.org/epi-section"/><code value="pil-4"/><display value="4. Possible side effects"/></coding></code>
            <text><status value="additional"/><div xmlns="http://www.w3.org/1999/xhtml"><p>Common (may affect up to 1 in 10 people): stomach pain. Uncommon (may affect up to 1 in 100 people): indigestion<ins class="rwi-mah" title="Applicant: add nausea following the signal evaluation">, nausea</ins>.</p></div></text>
          </section>
        </section>
      </Composition>
    </resource>
  </entry>
