<!-- FICTIONAL EXAMPLE for the RWI-pharma IG. Abbreviated FHIR ePI document Bundle (product information for WonderDrug 50 mg film-coated tablets),
     showing only the sections changed by this variation. Section and document type codes use a placeholder code system. -->
<!-- Annotated ePI: changes against the currently approved text are marked with XHTML <ins>/<del> in each section narrative.
     class="rwi-mah" = change made by the marketing authorisation holder; class="rwi-ha" = change made by the health authority;
     title = reason for the change. The clean ePI of the same version has the same structure without markup. -->
<Bundle xmlns="http://hl7.org/fhir">
  <identifier><system value="http://example.org/synthpharma/epi"/><value value="urn:uuid:7701e3a8-0861-5395-9a03-682eff1d5257"/></identifier>
